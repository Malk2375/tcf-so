# Modèle du fichier .env du serveur (à copier à la racine du projet : cp deploy/env.production.example .env).
# Remplacer 203.0.113.10 par l'adresse IP du VPS. Ne jamais commiter le fichier .env rempli.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=203.0.113.10
SITE_URL=https://203.0.113.10
CSRF_TRUSTED_ORIGINS=https://203.0.113.10

# --- Caddy (HTTPS) ---
SITE_ADDRESS=203.0.113.10
ACME_EMAIL=

# --- Fournisseurs (factices tant que les clés ne sont pas renseignées) ---
TTS_PROVIDER=fake
GOOGLE_TTS_API_KEY=
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=

# --- Comptes ---
SIGNUP_CODE=
EMAIL_ENABLED=false
